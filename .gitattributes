# Normalize line endings
* text=auto

# Scripts that must keep specific line endings
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sh    text eol=lf

# Source
*.cpp   text eol=crlf
*.h     text eol=crlf
*.wxs   text eol=crlf
*.yml   text eol=lf
*.yaml  text eol=lf

# FFmpeg patches must stay LF: CRLF breaks `git apply`
*.patch text eol=lf
# Treat license RTFs as binary to avoid EOL mangling
*.rtf   binary
